// Bản hợp nhất V4 + V5 (17 bảng, 30 FK), SQL Server 2022. 15/15 ca kiểm thử trong log nhóm đã PASS.
// Quy định: 5 phút online gateway/quầy; 30 phút online nhận tại quầy.
// Callback chỉ được backend đã xác minh gọi; không phải webhook hoàn chỉnh.
Project CinemaManagementV4V5 {
  database_type: 'SQL Server'
}
Table roles {
  role_id INT [pk, not null]
  role_code VARCHAR(30) [unique, not null]
  role_name NVARCHAR(80) [not null]
}
Table cinemas {
  cinema_id INT [pk, not null]
  cinema_name NVARCHAR(150) [not null]
  address NVARCHAR(255) [not null]
  status VARCHAR(20) [not null]
}
Table users {
  user_id INT [pk, not null]
  role_id INT [not null]
  cinema_id INT
  username VARCHAR(80) [unique, not null]
  full_name NVARCHAR(120) [not null]
  email NVARCHAR(160)
  phone VARCHAR(20)
  password_hash VARCHAR(255) [not null]
  status VARCHAR(20) [not null]
  created_at DATETIME2(0) [not null]
}
Table movies {
  movie_id INT [pk, not null]
  title NVARCHAR(250) [not null]
  description NVARCHAR(MAX)
  duration_minutes INT [not null]
  release_date DATE
  age_rating VARCHAR(10) [not null]
  status VARCHAR(20) [not null]
}
Table genres {
  genre_id INT [pk, not null]
  genre_name NVARCHAR(80) [unique, not null]
  is_active BIT [not null]
}
Table movie_genres {
  movie_id INT [not null]
  genre_id INT [not null]
  indexes { (movie_id, genre_id) [pk] }
}
Table rooms {
  room_id INT [pk, not null]
  cinema_id INT [not null]
  room_name NVARCHAR(80) [not null]
  status VARCHAR(20) [not null]
}
Table seat_types {
  seat_type_id INT [pk, not null]
  type_name NVARCHAR(60) [unique, not null]
  price_surcharge DECIMAL(12,2) [not null]
  is_active BIT [not null]
}
Table seats {
  seat_id INT [pk, not null]
  room_id INT [not null]
  seat_type_id INT [not null]
  row_label VARCHAR(5) [not null]
  seat_number INT [not null]
  is_active BIT [not null]
}
Table showtimes {
  showtime_id BIGINT [pk, not null]
  movie_id INT [not null]
  room_id INT [not null]
  starts_at DATETIMEOFFSET(0) [not null]
  ends_at DATETIMEOFFSET(0) [not null]
  base_price DECIMAL(12,2) [not null]
  status VARCHAR(20) [not null]
  created_by INT [not null]
}
Table showtime_seats {
  showtime_seat_id BIGINT [pk, not null]
  showtime_id BIGINT [not null]
  seat_id INT [not null]
  held_sale_id BIGINT
  held_unit_price DECIMAL(12,2)
  indexes { (showtime_seat_id, showtime_id) [unique] }
}
Table sales {
  sale_id BIGINT [pk, not null]
  receipt_code VARCHAR(40) [unique, not null]
  showtime_id BIGINT [not null]
  cashier_id INT
  customer_id INT
  sales_channel VARCHAR(10) [not null]
  payment_choice VARCHAR(20) [not null]
  pickup_code_hash VARBINARY(32)
  status VARCHAR(20) [not null]
  created_at DATETIME2(0) [not null]
  completed_at DATETIME2(0)
  hold_expires_at DATETIME2(3)
  held_seat_count INT
  indexes { (sale_id, showtime_id) [unique] }
}
Table booking_seats {
  Note: 'Lịch sử ghế theo hóa đơn. Cùng đơn, ghế và suất phải khớp.'
  booking_seat_id BIGINT [pk, not null]
  sale_id BIGINT [not null]
  showtime_seat_id BIGINT [not null]
  showtime_id BIGINT [not null]
  quoted_price DECIMAL(12,2) [not null]
  indexes {
    (sale_id, showtime_seat_id) [unique]
    (booking_seat_id, sale_id, showtime_seat_id) [unique]
  }
}
Table payments {
  payment_id BIGINT [pk, not null]
  sale_id BIGINT [unique, not null]
  amount DECIMAL(12,2) [not null]
  method VARCHAR(20) [not null]
  status VARCHAR(20) [not null]
  confirmed_by INT
  confirmed_at DATETIME2(0)
  gateway_attempt_id BIGINT [unique]
}
Table payment_attempts {
  attempt_id BIGINT [pk, not null]
  sale_id BIGINT [not null]
  attempt_code VARCHAR(80) [unique, not null]
  provider VARCHAR(30) [not null]
  expected_amount DECIMAL(12,2) [not null]
  status VARCHAR(20) [not null]
  created_at DATETIME2(3) [not null]
  completed_at DATETIME2(3)
}
Table payment_events {
  event_id BIGINT [pk, not null]
  attempt_id BIGINT [not null]
  provider VARCHAR(30) [not null]
  provider_event_id VARCHAR(120) [not null]
  event_result VARCHAR(12) [not null]
  paid_amount DECIMAL(12,2) [not null]
  processing_result VARCHAR(25) [not null]
  received_at DATETIME2(3) [not null]
}
Table tickets {
  ticket_id BIGINT [pk, not null]
  sale_id BIGINT [not null]
  showtime_seat_id BIGINT [unique, not null]
  booking_seat_id BIGINT [unique, not null]
  ticket_code VARCHAR(60) [unique, not null]
  unit_price DECIMAL(12,2) [not null]
  issued_at DATETIME2(0) [not null]
  checked_at DATETIME2(0)
  checked_by INT
}
Ref: users.role_id > roles.role_id
Ref: users.cinema_id > cinemas.cinema_id
Ref: movie_genres.movie_id > movies.movie_id
Ref: movie_genres.genre_id > genres.genre_id
Ref: rooms.cinema_id > cinemas.cinema_id
Ref: seats.room_id > rooms.room_id
Ref: seats.seat_type_id > seat_types.seat_type_id
Ref: showtimes.movie_id > movies.movie_id
Ref: showtimes.room_id > rooms.room_id
Ref: showtimes.created_by > users.user_id
Ref: showtime_seats.showtime_id > showtimes.showtime_id
Ref: showtime_seats.seat_id > seats.seat_id
Ref: sales.showtime_id > showtimes.showtime_id
Ref: sales.cashier_id > users.user_id
Ref: sales.customer_id > users.user_id
Ref: booking_seats.sale_id > sales.sale_id
Ref: booking_seats.showtime_seat_id > showtime_seats.showtime_seat_id
Ref: payments.sale_id > sales.sale_id
Ref: payments.confirmed_by > users.user_id
Ref: payment_attempts.sale_id > sales.sale_id
Ref: payment_events.attempt_id > payment_attempts.attempt_id
Ref: tickets.sale_id > sales.sale_id
Ref: tickets.showtime_seat_id > showtime_seats.showtime_seat_id
Ref: tickets.booking_seat_id > booking_seats.booking_seat_id
Ref: tickets.checked_by > users.user_id
Ref: showtime_seats.held_sale_id > sales.sale_id

Ref: booking_seats.(sale_id, showtime_id) > sales.(sale_id, showtime_id)
Ref: booking_seats.(showtime_seat_id, showtime_id) > showtime_seats.(showtime_seat_id, showtime_id)
Ref: tickets.(booking_seat_id, sale_id, showtime_seat_id) > booking_seats.(booking_seat_id, sale_id, showtime_seat_id)
Ref: payments.gateway_attempt_id > payment_attempts.attempt_id
Table customer_support {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  support_id BIGINT [pk, increment]
  customer_id INT [not null]
  assigned_to INT
  subject NVARCHAR(200) [not null]
  content NVARCHAR(MAX) [not null]
  status VARCHAR(20) [not null]
  created_at DATETIME2(0) [not null]
}

Table employee_profiles {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  employee_id INT [pk, increment]
  user_id INT [not null, unique]
  contract_number VARCHAR(50)
  contract_start DATE
  contract_end DATE
  base_salary DECIMAL(14,2)
}

Table work_shifts {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  shift_id BIGINT [pk, increment]
  cinema_id INT [not null]
  shift_name NVARCHAR(80) [not null]
  starts_at DATETIME2(0) [not null]
  ends_at DATETIME2(0) [not null]
  status VARCHAR(20) [not null]
}

Table shift_assignments {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  assignment_id BIGINT [pk, increment]
  shift_id BIGINT [not null]
  employee_id INT [not null]
  status VARCHAR(20) [not null]
}

Table attendance_records {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  attendance_id BIGINT [pk, increment]
  assignment_id BIGINT [not null, unique]
  check_in DATETIME2(0)
  check_out DATETIME2(0)
  status VARCHAR(20) [not null]
}

Table leave_requests {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  leave_id BIGINT [pk, increment]
  employee_id INT [not null]
  from_date DATE [not null]
  to_date DATE [not null]
  status VARCHAR(20) [not null]
  approved_by INT
}

Table payrolls {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  payroll_id BIGINT [pk, increment]
  employee_id INT [not null]
  period_month DATE [not null]
  base_amount DECIMAL(14,2) [not null]
  allowance DECIMAL(14,2) [not null]
  deduction DECIMAL(14,2) [not null]
  net_amount DECIMAL(14,2) [not null]
  status VARCHAR(20) [not null]
}

Table maintenance_records {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  maintenance_id BIGINT [pk, increment]
  room_id INT [not null]
  seat_id INT
  reported_by INT [not null]
  description NVARCHAR(MAX) [not null]
  status VARCHAR(20) [not null]
  created_at DATETIME2(0) [not null]
}

Table products {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  product_id INT [pk, increment]
  product_name NVARCHAR(120) [not null]
  unit_price DECIMAL(12,2) [not null]
  status VARCHAR(20) [not null]
}

Table product_orders {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  product_order_id BIGINT [pk, increment]
  sale_id BIGINT
  cashier_id INT
  created_at DATETIME2(0) [not null]
  status VARCHAR(20) [not null]
}

Table product_order_items {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  item_id BIGINT [pk, increment]
  product_order_id BIGINT [not null]
  product_id INT [not null]
  quantity INT [not null]
  unit_price DECIMAL(12,2) [not null]
}

Table inventory_movements {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  movement_id BIGINT [pk, increment]
  cinema_id INT [not null]
  product_id INT [not null]
  quantity_delta INT [not null]
  reason VARCHAR(30) [not null]
  created_at DATETIME2(0) [not null]
}

Table promotions {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  promotion_id INT [pk, increment]
  code VARCHAR(50) [unique, not null]
  discount_type VARCHAR(15) [not null]
  discount_value DECIMAL(12,2) [not null]
  starts_at DATETIME2(0) [not null]
  ends_at DATETIME2(0) [not null]
  usage_limit INT
}

Table sale_promotions {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  sale_id BIGINT [pk, not null]
  promotion_id INT [not null]
  discount_amount DECIMAL(12,2) [not null]
}

Table refund_requests {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  refund_id BIGINT [pk, increment]
  sale_id BIGINT [not null]
  payment_id BIGINT [not null]
  requested_amount DECIMAL(12,2) [not null]
  refunded_amount DECIMAL(12,2)
  status VARCHAR(25) [not null]
  reason NVARCHAR(500)
  requested_at DATETIME2(0) [not null]
}

Table showtime_cancellations {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  cancellation_id BIGINT [pk, increment]
  showtime_id BIGINT [not null]
  requested_by INT [not null]
  reason NVARCHAR(500) [not null]
  status VARCHAR(25) [not null]
  created_at DATETIME2(0) [not null]
}

Table notifications {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  notification_id BIGINT [pk, increment]
  user_id INT [not null]
  sale_id BIGINT
  channel VARCHAR(20) [not null]
  recipient NVARCHAR(160) [not null]
  status VARCHAR(20) [not null]
  sent_at DATETIME2(0)
}

Table reviews {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  review_id BIGINT [pk, increment]
  customer_id INT [not null]
  movie_id INT [not null]
  rating INT [not null]
  comment NVARCHAR(MAX)
  created_at DATETIME2(0) [not null]
}

Table audit_logs {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  audit_id BIGINT [pk, increment]
  actor_id INT
  action VARCHAR(80) [not null]
  entity_name VARCHAR(80) [not null]
  entity_key VARCHAR(80)
  created_at DATETIME2(0) [not null]
}

Table price_rules {
  Note: 'Thiết kế mở rộng cho phạm vi 38 chức năng.'
  price_rule_id INT [pk, increment]
  cinema_id INT
  seat_type_id INT
  start_date DATE
  end_date DATE
  adjustment DECIMAL(12,2) [not null]
  status VARCHAR(20) [not null]
}

Ref: customer_support.customer_id > users.user_id
Ref: customer_support.assigned_to > users.user_id
Ref: employee_profiles.user_id > users.user_id
Ref: work_shifts.cinema_id > cinemas.cinema_id
Ref: shift_assignments.shift_id > work_shifts.shift_id
Ref: shift_assignments.employee_id > employee_profiles.employee_id
Ref: attendance_records.assignment_id > shift_assignments.assignment_id
Ref: leave_requests.employee_id > employee_profiles.employee_id
Ref: leave_requests.approved_by > users.user_id
Ref: payrolls.employee_id > employee_profiles.employee_id
Ref: maintenance_records.room_id > rooms.room_id
Ref: maintenance_records.seat_id > seats.seat_id
Ref: maintenance_records.reported_by > users.user_id
Ref: product_orders.sale_id > sales.sale_id
Ref: product_orders.cashier_id > users.user_id
Ref: product_order_items.product_order_id > product_orders.product_order_id
Ref: product_order_items.product_id > products.product_id
Ref: inventory_movements.cinema_id > cinemas.cinema_id
Ref: inventory_movements.product_id > products.product_id
Ref: sale_promotions.sale_id > sales.sale_id
Ref: sale_promotions.promotion_id > promotions.promotion_id
Ref: refund_requests.sale_id > sales.sale_id
Ref: refund_requests.payment_id > payments.payment_id
Ref: showtime_cancellations.showtime_id > showtimes.showtime_id
Ref: showtime_cancellations.requested_by > users.user_id
Ref: notifications.user_id > users.user_id
Ref: notifications.sale_id > sales.sale_id
Ref: reviews.customer_id > users.user_id
Ref: reviews.movie_id > movies.movie_id
Ref: audit_logs.actor_id > users.user_id
Ref: price_rules.cinema_id > cinemas.cinema_id
Ref: price_rules.seat_type_id > seat_types.seat_type_id
